# Copie para .env. Gere senhas aleatórias locais; nunca use credenciais antigas.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3001
TRUST_PROXY=0
ALLOW_REGISTRATION=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mqfire_tg_v2
DB_USER=mqfire
DB_PASSWORD=
DB_ROOT_PASSWORD=
# TLS obrigatório fora da rede privada; caminho para CA do provedor.
DB_TLS_CA_FILE=
# Desativado por padrão. O destinatário é configurado pelo usuário no painel.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
