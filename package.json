{
  "name": "mq-fire-tg",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.js",
    "test:browser": "node tests/browser/smoke.js",
    "test:firmware": "g++ -std=c++11 -Wall -Wextra -Werror -Iarduino/include tests/firmware.cpp -o /tmp/mqfire-firmware-test && /tmp/mqfire-firmware-test",
    "check:secrets": "node scripts/check-secrets.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "express": "5.1.0",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
